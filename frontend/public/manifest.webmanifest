{
  "name": "ChainVerify",
  "short_name": "ChainVerify",
  "description": "Enterprise blockchain document verification platform with offline and installable PWA support.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f172a",
